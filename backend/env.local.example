# Add these lines to backend/.env on YOUR COMPUTER (never on Render). Replace every <...> with your real value.
# Do not paste real keys into chat.

# --- Supabase: the same database the live app uses (Supabase > Project Settings > Database > Connection string) ---
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres

# --- Embeddings: must be the same Gemini key/model the live app uses, or search won't match the new chunks ---
GEMINI_API_KEY=<your-gemini-key>
EMBEDDING_MODEL=gemini-embedding-001

# --- Where the original files come from (modules stored in Google Drive), same values as Render ---
# GOOGLE_... / DRIVE_... lines: copy them exactly from your Render environment

# --- Local RapidOCR mode ---
OCR_LOCAL=1
OCR_MAX_PAGES=500            # default is 40 scanned pages per file
OCR_LOCAL_MIN_CHARS=20       # pages with less text than this go to a vision model, if one is set below
PDF_BATCH_PAGES=10

# --- Optional fallback for pages RapidOCR can't read (leave empty to use RapidOCR only) ---
GROQ_API_KEY=
GROQ_VISION_MODEL=
